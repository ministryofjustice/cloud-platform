        <mxCell id="buNote" value="One BU account per BU per tier (OCTO, LAA, HMPPS, Central Digital, …). Metric data stays in the BU account." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#607D8B;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="716" width="440" height="20" as="geometry" />
