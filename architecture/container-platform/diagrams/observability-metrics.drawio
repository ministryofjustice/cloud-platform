        <!-- ============ CROSS-ACCOUNT IAM ROLES ============ -->
        <mxCell id="roleNl" value="Per-BU cross-account IAM role (non-live, scoped per BU — #8517)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
