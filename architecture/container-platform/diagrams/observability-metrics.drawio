        <!-- ============ NON-LIVE AMG ACCOUNT ============ -->
        <mxCell id="acctNonlive" value="cloud-platform-nonlive account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grpIconSize=0;strokeColor=#3334B9;fillColor=none;verticalAlign=top;fontColor=#3334B9;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="650" y="90" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="amgNl" value="AMG — NON-LIVE (Edit permitted)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_grafana;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="amgNlDetail" value="Queries all non-live BU AMP + CloudWatch (tier-scoped: one data source per BU). Per-BU isolation (#8509): data source amp-&lt;bu&gt; · default-deny data-source permission (Query = that BU's team only) · team ← BU-parent IdC group · per-BU folder. AMG workspace IAM role assumes the per-BU cross-account roles. Dashboard authoring happens here (Edit)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FA8DA;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="120" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="eQNl" value="query (assume-role, SigV4)" style="endArrow=block;html=1;strokeColor=#3334B9;fontSize=9;" edge="1" parent="1" source="roleNl" target="amgNl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ LIVE AMG ACCOUNT ============ -->
        <mxCell id="acctLive" value="cloud-platform-live account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grpIconSize=0;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;fontColor=#8C4FFF;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="650" y="350" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="amgL" value="AMG — LIVE (Viewer-only)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_grafana;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="390" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="amgLDetail" value="Queries all live BU AMP + CloudWatch (tier-scoped: one data source per BU). Same per-BU isolation primitives as non-live (data sources, default-deny permissions, teams, folders). AMG workspace IAM role assumes the per-BU cross-account roles. Production dashboards, read-only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B39DDB;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="380" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="eQL" value="query (assume-role, SigV4)" style="endArrow=block;html=1;strokeColor=#8C4FFF;fontSize=9;" edge="1" parent="1" source="roleL" target="amgL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ DEV AMG (neutral) ============ -->
        <mxCell id="acctDev" value="cloud-platform-development account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grpIconSize=0;strokeColor=#7D8998;fillColor=none;verticalAlign=top;fontColor=#5A6572;align=left;spacingLeft=24;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="610" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="amgDev" value="AMG — development" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_grafana;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="645" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="amgDevDetail" value="Serves ephemeral dev clusters' metrics for validation (#8560). Lifecycle (standing-with-ephemeral-data-sources vs. ephemeral workspace) is an open decision on #8560." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=9;align=left;spacingLeft=6;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="645" width="380" height="60" as="geometry" />
        </mxCell>

        <!-- ============ DASHBOARDS-AS-CODE (GitHub Actions) ============ -->
        <mxCell id="dacBox" value="Dashboards-as-code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292E;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="90" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="dac1" value="1. Author dashboards in non-live AMG (Edit), export JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="124" width="320" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dac2" value="2. Commit JSON to repo (PR → review)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="168" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dac3" value="3. GitHub Actions workflow: mint short-lived AMG SA token (per run), apply via Grafana provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2088FF;strokeColor=#0B5CAD;fontColor=#FFFFFF;fontSize=9;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="206" width="320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="dac4" value="4. Pipeline manages isolation objects (teams, folders, data sources, permissions) in BOTH workspaces. Dashboard JSON flows non-live → live; non-live is reconciled to Git for drift control and recovery (not re-authored)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1220" y="262" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dac5" value="Same Grafana provider + per-run token as #8510." style="text;html=1;fontSize=8;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="1220" y="346" width="320" height="16" as="geometry" />
        </mxCell>
        <mxCell id="eDacNl" value="applies to non-live" style="endArrow=block;html=1;strokeColor=#2088FF;fontSize=8;dashed=1;" edge="1" parent="1" source="dac3" target="amgNlDetail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eDacL" value="applies to live" style="endArrow=block;html=1;strokeColor=#2088FF;fontSize=8;dashed=1;" edge="1" parent="1" source="dac4" target="amgLDetail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ BU ACCESS MODEL ============ -->
        <mxCell id="accessBox" value="BU access model (#8558)&#10;BU-parent GitHub team → IdC group.&#10;Source of truth: consolidated business-units.json,&#10;shared with the ArgoCD access model (#8548).&#10;New sub-teams need no platform-team change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="410" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- ============ SSO + ENGINEERS ============ -->
        <mxCell id="idc" value="IAM Identity Center (SSO)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1310" y="540" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="roles" value="Platform engineers → ADMIN&#10;BU app engineers → Viewer (folder-scoped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#C9A227;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1230" y="620" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="eIdcRoles" style="endArrow=block;html=1;strokeColor=#303F9F;" edge="1" parent="1" source="idc" target="roles">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eIdcNl" value="SSO" style="endArrow=block;html=1;strokeColor=#3334B9;fontSize=8;" edge="1" parent="1" source="idc" target="acctNonlive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eIdcL" value="SSO" style="endArrow=block;html=1;strokeColor=#8C4FFF;fontSize=8;" edge="1" parent="1" source="idc" target="acctLive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ NOTES ============ -->
        <mxCell id="notes" value="Notes&#10;• Not scrapeable on EKS Auto Mode: CoreDNS (AWS-managed, no in-cluster endpoint, no CloudWatch); scheduler / controller-manager → CloudWatch only.&#10;• AMG is query/visualisation only — no metric data stored in the AMG accounts.&#10;• Separate live/non-live workspaces chosen over a single shared workspace: BU engineers need Edit to author (non-live), and to limit blast radius." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1120" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
