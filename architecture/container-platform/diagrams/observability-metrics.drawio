        <mxCell id="dac3" value="3. GitHub Actions workflow: mint short-lived AMG SA token (per run), apply via Grafana provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2088FF;strokeColor=#0B5CAD;fontColor=#FFFFFF;fontSize=9;align=left;spacingLeft=6;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="206" width="320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="dac4" value="4. Pipeline manages isolation objects (teams, folders, data sources, permissions) in BOTH workspaces. Dashboard JSON flows non-live → live; non-live is reconciled to Git for drift control and recovery (not re-authored)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1220" y="262" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dac5" value="Same Grafana provider + per-run token as #8510." style="text;html=1;fontSize=8;fontStyle=2;align=left;" parent="1" vertex="1">
          <mxGeometry x="1220" y="346" width="320" height="16" as="geometry" />
        </mxCell>
        <mxCell id="eDacNl" value="applies&lt;br&gt;to&lt;br&gt;non-live" style="endArrow=block;html=1;strokeColor=#2088FF;fontSize=8;dashed=1;" parent="1" source="dac3" target="amgNlDetail" edge="1">
          <mxGeometry x="-0.1136" y="-20" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eDacL" value="applies to live" style="endArrow=block;html=1;strokeColor=#2088FF;fontSize=8;dashed=1;" parent="1" source="dac4" target="amgLDetail" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="accessBox" value="BU access model (#8558)&#xa;BU-parent GitHub team → IdC group.&#xa;Source of truth: consolidated business-units.json,&#xa;shared with the ArgoCD access model (#8548).&#xa;New sub-teams need no platform-team change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="1200" y="410" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="roles" value="Platform engineers → ADMIN&#xa;BU app engineers → Viewer (folder-scoped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#C9A227;fontSize=9;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="1200" y="630" width="300" height="44" as="geometry" />
        </mxCell>
